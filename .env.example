# RoomFlow local development configuration
# Copy this file to .env and fill in real values locally.
# Never commit .env or place real secrets in this file.

SPRING_PROFILES_ACTIVE=dev

# MySQL through the local SSH tunnel
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=roomflow
DB_USERNAME=roomflow
DB_PASSWORD=

# MySQL root password (only used by docker-compose local dev middleware)
# IMPORTANT: must be set to a non-empty value before running docker compose.
# MySQL 8.4 refuses to initialize with an empty root password, and the
# compose healthcheck will fail until a non-empty value is provided.
MYSQL_ROOT_PASSWORD=

# Redis through the local SSH tunnel
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
# IMPORTANT: must be set to a non-empty value before running docker compose.
# docker-compose runs redis with --requirepass; an empty value causes
# redis-server to fail on startup, and the compose healthcheck will fail.
REDIS_PASSWORD=

# RabbitMQ through the local SSH tunnel
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15673
RABBITMQ_USERNAME=roomflow
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=roomflow

# Application security; generate a local random value before running auth flows
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Frontend development server
VITE_API_BASE_URL=http://localhost:8080
