# RoomFlow local development configuration
# Copy this file to .env and fill in real values locally.
# Never commit .env or place real secrets in this file.

SPRING_PROFILES_ACTIVE=dev

# MySQL through the local SSH tunnel
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=roomflow
DB_USERNAME=roomflow
DB_PASSWORD=

# MySQL root password (only used by docker-compose local dev middleware)
MYSQL_ROOT_PASSWORD=

# Redis through the local SSH tunnel
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=

# RabbitMQ through the local SSH tunnel
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15673
RABBITMQ_USERNAME=roomflow
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=roomflow

# Application security; generate a local random value before running auth flows
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Frontend development server
VITE_API_BASE_URL=http://localhost:8080
