# RoomFlow PRODUCTION environment template
#
# Copy this file to .env.production INSIDE THE PRODUCTION DEPLOY DIRECTORY on
# the production host (default /opt/roomflow/production) and fill in every
# CHANGE_ME before deploying:
#   cp .env.production.example .env.production
#
# .env.production is gitignored (see .gitignore) — this template is the only
# production env file that is tracked. Never commit a filled-in copy.
#
# Consumed by: docker/docker-compose.prod.yml
# Run from the DEPLOY DIRECTORY:
#   IMAGE_TAG=<40-char git sha> \
#   docker compose --project-directory . --env-file .env.production \
#     -f docker-compose.prod.yml up -d
#
# Every value below is a placeholder. Do not weaken one into a real credential
# in this file.
#
# ─────────────────────────────────────────────────────────────────────────────
# READ FIRST — SINGLE-QUOTE ANY VALUE THAT CONTAINS '$'
# ─────────────────────────────────────────────────────────────────────────────
# Identical rule to .env.staging.example (see that file for the full
# explanation): Compose re-interpolates unquoted and double-quoted env-file
# values, so a bare '$' expands into an empty or wrong value. Wrap the WHOLE
# value in single quotes:
#
#   RIGHT: JWT_SECRET='$abc123'
#   OK:    JWT_SECRET=$$abc123      (version-dependent alternative)
#   WRONG: JWT_SECRET=$abc123       -> empty signing key
#   WRONG: JWT_SECRET="$abc123"     -> double quotes do NOT protect
#
# Worst cases: ADMIN_PASSWORD_HASH (a BCrypt hash is ALL '$'), REDIS_PASSWORD
# (empty => unauthenticated Redis), JWT_SECRET (empty => backend dies at
# startup), DB_PASSWORD / MYSQL_ROOT_PASSWORD / RABBITMQ_PASSWORD (the images
# refuse empty credentials on a fresh volume).
#
# ─────────────────────────────────────────────────────────────────────────────
# Image pinning — REQUIRED, no default
# ─────────────────────────────────────────────────────────────────────────────
# The prod compose uses ${IMAGE_TAG:?...} (fail-fast). Set to the immutable
# 40-char git SHA that CI pushed (ghcr.io/niuyeyeplus/roomflow-{backend,
# frontend}). `latest` exists but must never be used for production.
IMAGE_TAG=CHANGE_ME_git_sha

# ─────────────────────────────────────────────────────────────────────────────
# Host port bindings (optional — every one has a working default)
# ─────────────────────────────────────────────────────────────────────────────
# Defaults avoid the dev stack (13306/16379/15673/15672/8080/80) and the
# staging stack (13307/16380/15674/15675/18080/8081) on a shared host.
# Middleware stays bound to 127.0.0.1; only the frontend is published publicly.
# On a dedicated host PROD_FRONTEND_PORT=80 is the usual choice (or put your
# TLS proxy in front).
PROD_DB_PORT=23306
PROD_REDIS_PORT=26379
PROD_RABBITMQ_PORT=25672
PROD_RABBITMQ_MGMT_PORT=25673
PROD_BACKEND_PORT=28080
PROD_FRONTEND_PORT=8082

# ─────────────────────────────────────────────────────────────────────────────
# MySQL
# ─────────────────────────────────────────────────────────────────────────────
# DB_HOST/DB_PORT are NOT read by docker-compose.prod.yml (the backend always
# reaches `mysql:3306` inside prod-net); they document the host-side tunnel
# endpoint for operators and for docker/backup.sh / docker/restore.sh.
DB_HOST=127.0.0.1
DB_PORT=23306
DB_NAME=roomflow
DB_USERNAME=roomflow
DB_PASSWORD=CHANGE_ME

# MySQL root password. Also the credential docker/backup.sh and
# docker/restore.sh use INSIDE the container (it is read from the container's
# own environment, never passed on a command line).
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
# Must be non-empty: redis-server starts with --requirepass; the redis
# command: re-checks the value it received and refuses to start rather than
# come up unauthenticated. Single-quote a value containing '$'.
REDIS_PASSWORD=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────────────────────────────────────────
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=25672
RABBITMQ_USERNAME=roomflow
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=roomflow

# ─────────────────────────────────────────────────────────────────────────────
# JWT signing key and token lifetimes
# ─────────────────────────────────────────────────────────────────────────────
# Generate a long random value, e.g.:  openssl rand -base64 48
# Use a DIFFERENT secret than staging — a leaked staging key must never sign
# production tokens. An empty value is a hard startup failure.
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN_PASSWORD_HASH — REQUIRED, hard startup failure if missing
# ─────────────────────────────────────────────────────────────────────────────
# application-prod.yml declares the Flyway placeholder
#   admin-password-hash: ${ADMIN_PASSWORD_HASH}
# with NO default. The value MUST be a BCrypt hash generated OFFLINE, never a
# plaintext password, and it seeds the initial admin account in the
# PRODUCTION database only. Write it SINGLE-QUOTED (a BCrypt hash is ALL '$'):
#
#   ADMIN_PASSWORD_HASH='$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy'
#
# Generate locally, e.g.:
#   htpasswd -bnBC 10 "" 'the-chosen-password' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
#   # or: python -c "import bcrypt;print(bcrypt.hashpw(b'...', bcrypt.gensalt(10)).decode())"
#
# Use a DIFFERENT admin password than staging.
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
# Required by the prod compose. Comma-separated origins allowed to make
# cross-origin calls to the API; empty means "no cross-origin requests", which
# makes browsers reject the SPA's API calls. Use the exact scheme+host+port
# the browser sees, e.g. https://roomflow.example.com
CORS_ALLOWED_ORIGINS=CHANGE_ME_https://roomflow.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Backups (host-side, read by docker/backup.sh — not by Compose)
# ─────────────────────────────────────────────────────────────────────────────
# Directory the pre-deploy backup and manual backups are written to. Must be
# on the production host. Files are gzip'ed mysqldump output named
# roomflow-prod-YYYYmmddTHHMMSSZ.sql.gz; the script keeps the newest
# BACKUP_KEEP copies (default 10).
BACKUP_DIR=/opt/roomflow/backups/production
BACKUP_KEEP=10
