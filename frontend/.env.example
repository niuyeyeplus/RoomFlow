# Axios base URL for direct backend access (e.g. http://localhost:8080).
# Leave empty to use same-origin relative paths; in dev, /api is forwarded by the
# Vite dev-server proxy (see VITE_API_PROXY_TARGET in vite.config.ts).
VITE_API_BASE_URL=
# Vite dev-server proxy target for /api (development only).
VITE_API_PROXY_TARGET=http://localhost:8080